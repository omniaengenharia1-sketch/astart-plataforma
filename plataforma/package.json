{
  "name": "astart-plataforma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "olhar": "node olhar.mjs",
    "contraste": "node contraste.mjs",
    "acessibilidade": "node acessibilidade.mjs",
    "telas": "node telas.mjs",
    "aovivo": "node aovivo.mjs",
    "projeto": "node projeto.mjs",
    "cadastro": "node cadastro.mjs",
    "calendario": "node calendario.mjs",
    "acessos": "node acessos.mjs",
    "galeria": "node galeria.mjs",
    "roteiros": "npm run enderecos && npm run build:exemplo && node telas.mjs && node olhar.mjs && node tema.mjs && node link.mjs && node senha.mjs && node midia.mjs && node compositor.mjs && node projeto.mjs && node cadastro.mjs && node calendario.mjs && node acessos.mjs && node galeria.mjs && node acessibilidade.mjs && node contraste.mjs",
    "tema": "node tema.mjs",
    "build:exemplo": "VITE_SUPABASE_URL= VITE_SUPABASE_PUBLISHABLE_KEY= VITE_SUPABASE_ANON_KEY= vite build",
    "link": "node link.mjs",
    "senha": "node senha.mjs",
    "midia": "node midia.mjs",
    "compositor": "node compositor.mjs",
    "enderecos": "node --experimental-strip-types enderecos.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "playwright-core": "^1.49.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
