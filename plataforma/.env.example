# Copie para .env.local e preencha. Sem estas duas, a plataforma abre em modo
# exemplo, com dados ficticios e um aviso no topo — nada finge estar ligado.
#
# As duas sao PUBLICAS por desenho: vao dentro do bundle. Quem decide o que cada
# pessoa alcanca e o RLS, dentro do banco.
#
# A `service_role` e a senha do banco NAO entram aqui, nem em nenhum arquivo do
# repositorio: elas moram no painel do Supabase.
VITE_SUPABASE_URL=https://SEU-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
