# ---------------------------------------------------------------------------
# Script de teste (scripts/agendar-post-teste.ts). NAO comitar o .env real.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Edge Function — definir com `supabase secrets set`, nao neste arquivo.
# ---------------------------------------------------------------------------
# META_API_VERSION=v23.0          # confira a versao vigente na doc da Meta
# TICK_SECRET=                    # mesmo valor da chave "tick_secret" no Vault
# TICK_LOTE_MAX=20
# SIGNED_URL_TTL_SEGUNDOS=7200
# ALERTA_WEBHOOK_URL=             # opcional (Slack/Discord)
#
# So para a excecao de OAuth (cliente sem Business Manager):
# META_APP_ID=
# META_APP_SECRET=
# RENOVAR_TOKEN_DIAS=7            # antecedencia da renovacao

# ---------------------------------------------------------------------------
# Token da Meta — vive no Vault, nunca em variavel de ambiente e nunca no front.
#   select vault.create_secret('<TOKEN>', 'meta_system_user_token');
# ---------------------------------------------------------------------------
